[Unit]
Description=Isolated Albiex Synth City product factory
After=network.target albiex-synth-city-product-tmux.service
Requires=albiex-synth-city-product-tmux.service
[Service]
Type=simple
User=deckproductctl
Group=deckproductctl
SupplementaryGroups=deckproduct-work
WorkingDirectory=/opt/albiex-synth-city-product/controller/backend
Environment=PATH=/opt/albiex-synth-city-product/bin:/opt/albiex-synth-city-product/tools:/usr/local/bin:/usr/bin:/bin
Environment=SYNTH_CITY_URL=http://127.0.0.1:8011
ExecStart=/opt/albiex-synth-city-product/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8011
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
UMask=0007
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
