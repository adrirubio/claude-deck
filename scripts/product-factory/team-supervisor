#!/usr/bin/python3
"""Supervise one configured team. Preserve work and never change its roster."""
import argparse
import datetime
import hashlib
import json
import os
import pathlib
import re
import signal
import sqlite3
import tempfile
import urllib.request

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()

def process(pid):
    path = pathlib.Path('/proc') / str(pid)
    raw = (path / 'stat').read_text()
    fields = raw[raw.rindex(')') + 2:].split()
    return int(fields[1]), fields[19], path.stat().st_uid

def save(path, data):
    path = pathlib.Path(path)
    fd, staging = tempfile.mkstemp(prefix='.team-supervisor-', dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as stream:
            stream.write(json.dumps(data, indent=2) + '\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(staging, path)
    finally:
        try:
            os.unlink(staging)
        except FileNotFoundError:
            pass

NOTICES = {
    'cybersecurity_notice': re.compile(r'this content was flagged for possible cybersecurity risk', re.I),
    'cyber_authorization_notice': re.compile(r'to get authorized for security work.{0,100}trusted access for cyber', re.I | re.S),
}
ERROR_CODES = {'content_policy_violation', 'safety_check_failed', 'cybersecurity_block', 'cybersecurity_blocked'}

def notice(record):
    # A quoted instruction or a tool result must not create a safety hold.
    kind = record.get('type')
    if kind == 'assistant':
        message = record.get('message') or {}
        content = message.get('content', [])
        if isinstance(content, list):
            text = '\n'.join(b.get('text', '') for b in content if isinstance(b, dict) and b.get('type') == 'text')
        else:
            text = str(content)
        for rule, pattern in NOTICES.items():
            if pattern.search(text):
                return rule
        if record.get('isApiErrorMessage'):
            code = _error_code(text)
            if code:
                return code
    if kind == 'system' and record.get('subtype') == 'api_error':
        error = record.get('error') or {}
        if isinstance(error, dict):
            for field in ['code', 'type']:
                if error.get(field) in ERROR_CODES:
                    return error[field]
    if kind == 'event_msg':
        payload = record.get('payload') or {}
        if payload.get('type') in {'error', 'warning', 'stream_error', 'agent_message'}:
            text = str(payload.get('message', ''))
            found = _match(text)
            if found:
                return found
            if payload.get('type') in {'error', 'stream_error'}:
                code = _error_code(text + '\n' + str(payload.get('codex_error_info', '')))
                if code:
                    return code
        # Codex 0.159: the agent's own text arrives as a completed AgentMessage item.
        item = payload.get('item') if payload.get('type') == 'item_completed' else None
        if isinstance(item, dict) and item.get('type') == 'AgentMessage':
            return _match(_texts(item.get('content')))
    if record.get('payload_type') == 'runtime.session':
        # Muse Code: the agent's own reply is assistant_message_committed. The user's
        # prompt, task output (tool results) and reasoning (which can quote the
        # prompt) are not checked.
        event = (record.get('payload') or {}).get('event') or {}
        if event.get('kind') == 'assistant_message_committed':
            return _match(str(event.get('text', '')))
        if event.get('kind') in {'error', 'model_failed', 'stream_error'}:
            text = str(event.get('message', ''))
            return _match(text) or _error_code(text)
        return None
    if kind == 'response_item':
        # Codex 0.159: the assistant message. Tool output and user input are not checked.
        payload = record.get('payload') or {}
        if payload.get('type') == 'message' and payload.get('role') == 'assistant':
            return _match(_texts(payload.get('content')))
    return None

def _texts(content):
    if not isinstance(content, list):
        return ''
    return '\n'.join(str(block.get('text', '')) for block in content if isinstance(block, dict))

def _error_code(text):
    # Longest first: cybersecurity_block is a prefix of cybersecurity_blocked.
    lowered = text.lower()
    for code in sorted(ERROR_CODES, key=lambda value: (-len(value), value)):
        if code in lowered:
            return code
    return None

def _match(text):
    for rule, pattern in NOTICES.items():
        if pattern.search(text):
            return rule
    return None

# Supervisor.record returns this for a line it skips. No JSON value can equal it.
SKIP = object()


class Supervisor:
    def __init__(self, config):
        self.config = config
        self.state_path = pathlib.Path(config['state_path'])
        self.hold_path = pathlib.Path(config['hold_path'])
        self.state = json.loads(self.state_path.read_text()) if self.state_path.exists() else {'offsets': {}, 'autonomy_enabled': False}

    def api(self, method, path, body=None):
        cfg = dict(line.split('=', 1) for line in pathlib.Path(self.config['operator_env']).read_text().splitlines() if '=' in line)
        request = urllib.request.Request(self.config['api'] + path, data=None if body is None else json.dumps(body).encode(), method=method, headers={'Content-Type': 'application/json', 'X-Deck-Operator-Token': cfg['OPERATOR_TOKEN']})
        with urllib.request.urlopen(request, timeout=8) as response:
            return json.load(response)

    def bindings(self):
        with sqlite3.connect('file:' + self.config['database'] + '?mode=ro', uri=True, timeout=2) as db:
            db.row_factory = sqlite3.Row
            rows = db.execute('SELECT b.*, s.launch_options, s.repo_path, s.provider FROM agent_pane_bindings b JOIN agent_team_slots s ON s.id=b.slot_id WHERE b.preset_id=?', (self.config['preset_id'],)).fetchall()
        live = []
        for row in rows:
            if row['slot_id'] not in self.config['slot_ids']:
                continue
            try:
                _, start, uid = process(row['pane_pid'])
            except (OSError, ValueError, IndexError):
                continue
            if start == row['pane_proc_start'] and uid == self.config['agent_uid']:
                live.append(dict(row))
        return live

    def freeze(self):
        roots = self.bindings()
        processes = {}
        for path in pathlib.Path('/proc').iterdir():
            if not path.name.isdigit():
                continue
            try:
                processes[int(path.name)] = process(int(path.name))
            except (OSError, ValueError, IndexError):
                continue
        selected = {row['pane_pid'] for row in roots}
        while True:
            added = {pid for pid, (parent, _, uid) in processes.items() if parent in selected and uid == self.config['agent_uid']}
            if added <= selected:
                break
            selected |= added
        frozen = []
        for pid in sorted(selected):
            try:
                if process(pid) != processes[pid]:
                    continue
                os.kill(pid, signal.SIGSTOP)
                frozen.append({'pid': pid, 'proc_start': processes[pid][1]})
            except (OSError, KeyError):
                pass
        return frozen

    def stop(self, reason, *, security=False, rule=None):
        event = {'time_utc': now(), 'preset_id': self.config['preset_id'], 'reason': reason, 'rule': rule, 'security_hold': security}
        if security:
            save(self.hold_path, event)
        try:
            self.api('PATCH', '/agent-teams/presets/' + str(self.config['preset_id']), {'autonomy_enabled': False})
            for scope in self.config['scope_ids']:
                self.api('PATCH', '/agent-teams/github-scopes/' + str(scope), {'enabled': False})
            event['autonomy_off_verified'] = not self.api('GET', '/agent-teams/presets/' + str(self.config['preset_id']))['autonomy_enabled']
        except Exception as exc:
            event['controller_error'] = type(exc).__name__
        try:
            event['frozen_processes'] = self.freeze()
        except Exception as exc:
            event['freeze_error'] = type(exc).__name__
        if security:
            save(self.hold_path, event)
        self.state.update(last_tick=now(), mode='WAITING_FOR_USER' if security else 'RECOVERY_REQUIRED', autonomy_enabled=False, incident=event)
        save(self.state_path, self.state)

    def scan(self, bindings):
        paths = set()
        for binding in bindings:
            options = json.loads(binding['launch_options'] or '{}')
            native_id = options.get('session_id')
            if not native_id or not re.fullmatch(r'[0-9a-f-]{36}', native_id):
                raise ValueError('native_session_identity_missing')
            paths.add(self.transcript(binding.get('provider') or 'claude-code', binding['repo_path'], native_id))
        for path in paths:
            key = str(path)
            offset = int(self.state['offsets'].get(key, 0))
            if path.stat().st_size < offset:
                raise ValueError('native_transcript_shrank')
            with path.open('rb') as stream:
                stream.seek(offset)
                inspected = 0
                while inspected < 16 * 1024 * 1024:
                    start = stream.tell()
                    line = stream.readline(8 * 1024 * 1024)
                    if not line:
                        break
                    if not line.endswith(b'\n'):
                        stream.seek(start)
                        if len(line) == 8 * 1024 * 1024:
                            raise ValueError('native_record_too_large')
                        break
                    inspected += len(line)
                    record = self.record(line)
                    if record is SKIP:
                        continue
                    found = notice(record)
                    if found:
                        self.stop('security_notice', security=True, rule=found)
                        return False
                self.state['offsets'][key] = stream.tell()
        return True

    def record(self, line):
        """Parse one transcript line. A crash can leave NUL bytes where it lost data.

        The NULs carry no content. The record after them is inspected as usual.
        A line that holds only NULs returns SKIP, which no parsed value can equal.
        A damaged fragment fails closed, unless the operator acknowledged that
        exact line by its SHA-256. A record that is not a JSON object fails closed.
        """
        if b'\x00' not in line:
            return self.object(json.loads(line))
        self.state['damaged_records_seen'] = self.state.get('damaged_records_seen', 0) + 1
        remainder = line.replace(b'\x00', b'').strip()
        if not remainder:
            return SKIP
        try:
            parsed = json.loads(remainder)
        except ValueError:
            if hashlib.sha256(line).hexdigest() in set(self.config.get('acknowledged_damaged_records', [])):
                return SKIP
            raise ValueError('native_record_damaged')
        return self.object(parsed)

    @staticmethod
    def object(parsed):
        # Every native record is a JSON object. Any other value fails closed.
        if not isinstance(parsed, dict):
            raise ValueError('native_record_not_object')
        return parsed

    def transcript(self, provider, repo_path, native_id):
        """Return the native transcript of one bound session, or fail closed."""
        if provider == 'claude-code':
            folder = '-' + repo_path.strip('/').replace('/', '-')
            path = pathlib.Path(self.config['native_project_root']) / folder / (native_id + '.jsonl')
        elif provider == 'codex-cli':
            # Codex writes one rollout per session under sessions/YYYY/MM/DD/,
            # and its file name ends with the session UUID. Check that exactly
            # one matches on every scan: a second rollout for the same session
            # must not go unread. The recorded path is informational only.
            root = pathlib.Path(self.config['codex_sessions_root'])
            found = sorted(root.glob('*/*/*/rollout-*-' + native_id + '.jsonl'))
            if len(found) != 1:
                raise FileNotFoundError('native_transcript_missing' if not found else 'native_transcript_ambiguous')
            path = found[0]
            self.state.setdefault('native_paths', {})[native_id] = str(path)
        elif provider == 'muse-cli':
            # Muse Code writes sessions/YYYY/MM/DD/<session uuid>/session.jsonl.
            # As for Codex, exactly one match must exist on every scan.
            root = pathlib.Path(self.config['muse_sessions_root'])
            found = sorted(root.glob('*/*/*/' + native_id + '/session.jsonl'))
            if len(found) != 1:
                raise FileNotFoundError('native_transcript_missing' if not found else 'native_transcript_ambiguous')
            path = found[0]
            self.state.setdefault('native_paths', {})[native_id] = str(path)
        else:
            raise ValueError('native_provider_unsupported')
        if not path.exists():
            raise FileNotFoundError('native_transcript_missing')
        return path

    def tick(self):
        if self.hold_path.exists():
            self.api('PATCH', '/agent-teams/presets/' + str(self.config['preset_id']), {'autonomy_enabled': False})
            for scope in self.config['scope_ids']:
                self.api('PATCH', '/agent-teams/github-scopes/' + str(scope), {'enabled': False})
            self.state.update(last_tick=now(), mode='WAITING_FOR_USER', autonomy_enabled=False)
            save(self.state_path, self.state)
            return
        preset = self.api('GET', '/agent-teams/presets/' + str(self.config['preset_id']))
        if {slot['id'] for slot in preset['slots'] if slot['enabled']} != set(self.config['slot_ids']):
            raise ValueError('configured_roster_changed')
        bindings = self.bindings()
        if not self.scan(bindings):
            return
        members = self.api('GET', '/agent-mail/team?sync=true')['members']
        connected = {m.get('team_slot_id') for m in members if m.get('team_preset_id') == self.config['preset_id'] and m.get('status') == 'connected' and m.get('wake_state') == 'wakeable'}
        # An on-demand slot (for example a reviewer launched at gates) may be stopped.
        # It is still scanned whenever it is bound.
        required = set(self.config['slot_ids']) - set(self.config.get('on_demand_slot_ids', []))
        missing = required - connected
        self.state['binding_failures'] = self.state.get('binding_failures', 0) + 1 if missing else 0
        if preset['autonomy_enabled'] and self.state['binding_failures'] >= 3:
            self.stop('authenticated_member_missing')
            return
        self.state.update(last_tick=now(), mode='SUPERVISING' if preset['autonomy_enabled'] else 'PREPARED_DISARMED', autonomy_enabled=preset['autonomy_enabled'], connected_slots=sorted(connected), missing_slots=sorted(missing), live_panes=len(bindings))
        save(self.state_path, self.state)

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    args = parser.parse_args()
    supervisor = Supervisor(json.loads(pathlib.Path(args.config).read_text()))
    try:
        supervisor.tick()
    except Exception as exc:
        if supervisor.state.get('autonomy_enabled') or pathlib.Path(supervisor.config['armed_path']).exists():
            supervisor.stop('supervision_' + type(exc).__name__)
        else:
            supervisor.state.update(last_tick=now(), mode='STARTUP_GAP', error_type=type(exc).__name__)
            save(supervisor.state_path, supervisor.state)
