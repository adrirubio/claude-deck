 result={'controller':URL,'pin':json.loads((STATE/'preparation.json').read_text())['pin'],'preset':p['name'],'autonomy_enabled':p['autonomy_enabled'],'repo':s['repo_owner']+'/'+s['repo_name'],'scope_enabled':s['enabled'],'merge_policy':s['merge_policy'],'concurrency':s['max_concurrent_dispatched'],'github_poll_credential_configured':s['github_poll_token_configured'],'hold':(WORK/'operations/HOLD.json').exists(),'supervisor_mode':sup.get('mode'),'supervisor_last_tick':sup.get('last_tick'),'slots':[{'id':x['id'],'name':x['display_name'],'repo_path':x['repo_path'],'model':x['launch_options'].get('model')} for x in p['slots']]}
 print(json.dumps(result,indent=2));return result
parser=argparse.ArgumentParser();parser.add_argument('command',choices=['status','plan','launch-bootstrap','configure-ambient-github','arm','pause']);parser.add_argument('--confirm',action='store_true');args=parser.parse_args()
