import argparse,datetime,json,os,pathlib,pwd,re,subprocess,sys,tempfile,urllib.request
BASE=pathlib.Path('/opt/albiex-synth-city-product');STATE=BASE/'state';WORK=pathlib.Path('/home/deckproductctl/work');URL='http://127.0.0.1:8011';ENV=BASE/'controller/backend/.env'
def cfg():return dict(l.split('=',1) for l in ENV.read_text().splitlines() if '=' in l)
def api(method,path,body=None):
 req=urllib.request.Request(URL+'/api/v1'+path,data=None if body is None else json.dumps(body).encode(),method=method,headers={'Content-Type':'application/json','X-Synth-City-Operator-Token':cfg()['OPERATOR_TOKEN']})
