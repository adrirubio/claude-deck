def stamp():return datetime.datetime.now(datetime.timezone.utc).isoformat()
def store(p,data):p.write_text(json.dumps(data,indent=2)+'\n')
# The controller .env is root-controlled. The secret goes into a fresh 0600 file made beside it, owned like the
# original before any secret byte is written, then replaces the original in one step: a failure leaves it untouched.
def write_secret(path,text):
 path=pathlib.Path(path)
 if path.is_symlink():sys.exit('Refusing to write credentials through a symlink.')
 st=path.stat();fd,tmp=tempfile.mkstemp(dir=str(path.parent),prefix='.'+path.name+'.')
 try:
  os.fchown(fd,st.st_uid,st.st_gid)
  with os.fdopen(fd,'w') as f:f.write(text);f.flush();os.fsync(f.fileno())
  os.replace(tmp,path)
 except BaseException:
  try:os.unlink(tmp)
  except FileNotFoundError:pass
  raise
# The agent users own their home directories, so root never writes there. This runs AS the agent user, reads the
# file from stdin (never argv or the environment), refuses a symlinked directory, secures the directory first,
# writes a new 0600 file with O_EXCL and renames it over hosts.yml, so an existing file or a planted link is
# replaced and never receives the secret.
HOSTS_WRITER='''import os,sys
d,name=sys.argv[1],sys.argv[2]
os.umask(0o077)
os.makedirs(d,mode=0o700,exist_ok=True)
dfd=os.open(d,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
os.fchmod(dfd,0o700)
view=memoryview(sys.stdin.buffer.read())
tmp='.%s.%d.tmp'%(name,os.getpid())
fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=dfd)
try:
 while view:view=view[os.write(fd,view):]
 os.fsync(fd);os.close(fd)
 os.rename(tmp,name,src_dir_fd=dfd,dst_dir_fd=dfd)
except BaseException:
 try:os.unlink(tmp,dir_fd=dfd)
 except FileNotFoundError:pass
 raise
'''
