 if scope['id']!=1 or scope['base_ref']!='origin/feature/software-delivery-product-reposition' or scope['max_auto_merges_per_day']!=0 or scope['max_approval_rounds']!=3 or scope['max_verification_retries']!=2 or scope['continuation_enabled']:sys.exit('Scope differs from the accepted bootstrap policy.')
 if queue['repo']!='juanrubio/claude-deck' or queue['integration']!='feature/software-delivery-product-reposition':sys.exit('Ledger destination mismatch.')
 # Initial stage admits only the first backend task; later gates are checked by B1.
