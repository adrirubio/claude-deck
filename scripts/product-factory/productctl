 if not args.confirm:sys.exit('Use --confirm only after the operator chooses to start Lane B autonomy.')
 s=status()
 if s['hold'] or (STATE/'HOLD.json').exists():sys.exit('Lane held; no automatic resume. Await user instructions.')
 if s['repo']!='juanrubio/claude-deck' or s['merge_policy']!='human' or s['concurrency']!=1:sys.exit('Recorded repository, human merge and concurrency one policy required.')
 if not s['github_poll_credential_configured']:sys.exit('Choose/configure product GitHub credentials before arming.')
 sup=json.loads((STATE/'supervisor-state.json').read_text());last=datetime.datetime.fromisoformat(sup['last_tick']);age=(datetime.datetime.now(datetime.timezone.utc)-last).total_seconds()
 if sup.get('mode')!='PREPARED_DISARMED' or sup.get('autonomy_enabled'):sys.exit('Supervisor must confirm prepared/disarmed state before arming.')
 if age>30:sys.exit('Supervisor is stale; arming refused.')
 queue=json.loads((WORK/'operations/queue.json').read_text())
 if not queue['gates']['packet_accepted']:sys.exit('Packet review acceptance required before autonomous implementation.')
 members=api('GET','/agent-mail/team?sync=true')['members']
 expected={x['id'] for x in api('GET','/agent-teams/presets/1')['slots']}
